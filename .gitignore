.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
node_modules/
dist/
.DS_Store
*.log
.idea/
*.iml

# ADR-0151: the Vite output is copied here inside the image's Gradle stage. It is a build product
# that happens to land in a source tree, and it is never committed.
nodqora-app/src/main/resources/static/

# What the install has an operator write beside `compose.yaml` — `./config` and `./kubeconfig`
# (ADR-0152) — and what tends to sit next to them. A contributor who follows the install document
# inside a clone is one `git add .` from committing a cluster credential.
/config/
/kubeconfig
.env
.env.*
*.pem
*.key
*.p12
*.jks
*.bak
